{
  "name": "@keepyourprompts/claude-agent-sdk",
  "version": "0.1.0",
  "description": "Keep Your Prompts for the Claude Agent SDK (TypeScript): system prompt, subagent definitions and skills from deployed prompts, rebuilt for every session.",
  "keywords": [
    "prompts",
    "llm",
    "prompt-management",
    "claude",
    "claude-agent-sdk",
    "agents",
    "skills"
  ],
  "homepage": "https://keepyourprompts.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keep-your-prompts/keep-your-prompts-sdk.git",
    "directory": "adapters/claude-agent-sdk-ts"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.14"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@keepyourprompts/sdk": "^0.1.0",
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0 <1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@keepyourprompts/sdk": "file:../../typescript",
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
