{
  "name": "@keepyourprompts/openai-agents",
  "version": "0.1.0",
  "description": "Keep Your Prompts for the OpenAI Agents SDK (JavaScript): dynamic instructions that render the deployed prompt on every run, so deploys apply without a restart.",
  "keywords": [
    "prompts",
    "llm",
    "prompt-management",
    "openai",
    "openai-agents",
    "agents"
  ],
  "homepage": "https://keepyourprompts.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keep-your-prompts/keep-your-prompts-sdk.git",
    "directory": "adapters/openai-agents-js"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@keepyourprompts/sdk": "^0.1.0",
    "@openai/agents-core": ">=0.21.0 <1"
  },
  "devDependencies": {
    "@keepyourprompts/sdk": "file:../../typescript",
    "@openai/agents-core": "^0.21.0",
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
