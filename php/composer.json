{
    "name": "keepyourprompts/sdk",
    "description": "Keep Your Prompts PHP SDK: read deployed prompts from a shared local cache, revalidated in the background against interchangeable mirrors.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "prompts",
        "llm",
        "prompt-management",
        "anthropic",
        "openai",
        "laravel"
    ],
    "homepage": "https://github.com/keep-your-prompts/keep-your-prompts-sdk",
    "support": {
        "issues": "https://github.com/keep-your-prompts/keep-your-prompts-sdk/issues",
        "source": "https://github.com/keep-your-prompts/keep-your-prompts-sdk/tree/main/php"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "illuminate/config": "^10.0 || ^11.0 || ^12.0",
        "illuminate/container": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "suggest": {
        "ext-apcu": "Shares prompt state between PHP-FPM workers in shared memory (otherwise a file cache is used)",
        "ext-curl": "Faster HTTP with keep-alive (otherwise PHP stream wrappers are used)",
        "psr/http-client": "Bring your own PSR-18 HTTP client (KeepYourPrompts\\Http\\Psr18Transport)"
    },
    "autoload": {
        "psr-4": {
            "KeepYourPrompts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KeepYourPrompts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KeepYourPrompts\\Laravel\\KeepYourPromptsServiceProvider"
            ],
            "aliases": {
                "Prompts": "KeepYourPrompts\\Laravel\\Facades\\Prompts"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
