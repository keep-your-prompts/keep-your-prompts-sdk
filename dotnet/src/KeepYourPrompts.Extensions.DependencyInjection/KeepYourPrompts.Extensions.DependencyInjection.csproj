<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>KeepYourPrompts</RootNamespace>
    <PackageId>KeepYourPrompts.Extensions.DependencyInjection</PackageId>
    <Description>services.AddKeepYourPrompts(): registers a singleton KeepYourPromptsClient for ASP.NET Core and the generic host, logging through ILogger.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../KeepYourPrompts.Sdk/KeepYourPrompts.Sdk.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
