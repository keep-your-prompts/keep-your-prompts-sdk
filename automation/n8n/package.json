{
  "name": "n8n-nodes-keepyourprompts",
  "version": "0.1.0",
  "description": "n8n community nodes for Keep Your Prompts: search, render, version and deploy prompts, capture into the inbox, and trigger workflows on signed webhook events.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://keepyourprompts.com",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "keepyourprompts",
    "prompts",
    "prompt-management",
    "llm"
  ],
  "author": {
    "name": "Keep Your Prompts",
    "email": "support@keepyourprompts.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keep-your-prompts/keep-your-prompts-sdk.git",
    "directory": "automation/n8n"
  },
  "bugs": {
    "url": "https://github.com/keep-your-prompts/keep-your-prompts-sdk/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/KeepYourPromptsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/KeepYourPrompts/KeepYourPrompts.node.js",
      "dist/nodes/KeepYourPromptsTrigger/KeepYourPromptsTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.54.5",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
