{
    "url": "https://api.keepyourprompts.com/v1/me",
    "method": "GET",
    "headers": {
        "authorization": "Bearer {{parameters.apiKey}}",
        "accept": "application/json"
    },
    "response": {
        "metadata": {
            "type": "text",
            "value": "{{body.workspace.name}} ({{body.user.email}})"
        },
        "error": {
            "message": "[{{statusCode}}] {{ifempty(body.detail, ifempty(body.title, 'The API key was not accepted'))}}"
        }
    },
    "log": {
        "sanitize": [
            "request.headers.authorization"
        ]
    }
}
