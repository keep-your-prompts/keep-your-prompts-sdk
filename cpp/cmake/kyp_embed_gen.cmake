# Script mode: cmake -DKYP_DIR=<snapshot> -DKYP_OUT=<file.cpp> -P kyp_embed_gen.cmake
file(GLOB_RECURSE files RELATIVE "${KYP_DIR}" "${KYP_DIR}/envs/*.json" "${KYP_DIR}/blobs/*")
list(SORT files)
set(arrays "")
set(paths "")
set(datas "")
set(sizes "")
set(n 0)
foreach(f IN LISTS files)
  if(NOT (f MATCHES "^blobs/[0-9a-f]+$" OR f MATCHES "^envs/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*\\.json$"))
    continue()
  endif()
  file(READ "${KYP_DIR}/${f}" hex HEX)
  file(SIZE "${KYP_DIR}/${f}" size)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n  " bytes "${bytes}")
  string(APPEND arrays "static const unsigned char kyp_file_${n}[] = {\n  ${bytes}0x00};\n")
  string(APPEND paths "  \"${f}\",\n")
  string(APPEND datas "  kyp_file_${n},\n")
  string(APPEND sizes "  ${size}u,\n")
  math(EXPR n "${n} + 1")
endforeach()
if(n EQUAL 0)
  message(FATAL_ERROR "kyp_embed_snapshot: no snapshot files under ${KYP_DIR}")
endif()
file(WRITE "${KYP_OUT}" "// Generated by kyp_embed_snapshot from ${KYP_DIR}. Do not edit.
#include <cstddef>
namespace kyp { namespace detail {
void register_embedded_files(const char* const* paths, const unsigned char* const* data,
                             const std::size_t* sizes, std::size_t count) noexcept;
} }
namespace {
${arrays}
const char* const kyp_paths[] = {
${paths}};
const unsigned char* const kyp_data[] = {
${datas}};
const std::size_t kyp_sizes[] = {
${sizes}};
struct KypEmbeddedRegistrar {
  KypEmbeddedRegistrar() noexcept {
    kyp::detail::register_embedded_files(kyp_paths, kyp_data, kyp_sizes, ${n});
  }
};
const KypEmbeddedRegistrar kyp_embedded_registrar;
}  // namespace
")
